# ─── Admin (obbligatorie in produzione) ──────────────────────────────────────
# Senza queste due variabili il pannello /admin resta chiuso in produzione:
# i valori qui sotto sono pubblici e valgono solo per lo sviluppo locale.

# Password pannello admin (/admin)
ADMIN_PASSWORD=notog2026

# Segreto per firmare la sessione admin e derivare la chiave feed
ADMIN_SECRET=cambia-questa-stringa-lunga-casuale

# ─── Sito ────────────────────────────────────────────────────────────────────

# URL pubblico del sito (usato per SEO, feed, sitemap e llms.txt)
NEXT_PUBLIC_SITE_URL=https://www.notog-costruzioni.it

# Numero WhatsApp (senza +, senza spazi). Es: 393331234567
NEXT_PUBLIC_WHATSAPP=393511234567

# ─── Archiviazione ───────────────────────────────────────────────────────────
# Su hosting serverless (Vercel) il filesystem è di sola lettura: senza
# DATABASE_URL gli immobili sono in sola lettura dal seed e le richieste dal
# form NON vengono salvate.

# Connessione Postgres/Neon per immobili e richieste
DATABASE_URL=

# Token Vercel Blob per il caricamento delle foto dall'admin
BLOB_READ_WRITE_TOKEN=

# ─── Opzionali ───────────────────────────────────────────────────────────────

# Chiave dei feed portali. Se assente viene derivata da ADMIN_SECRET.
FEED_KEY=

# Notifica email a ogni nuova richiesta dal sito (servono tutte e tre).
# Senza queste, le richieste si leggono solo in /admin/lead.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=sito@notog.it
LEAD_NOTIFY_TO=info@notog.it
